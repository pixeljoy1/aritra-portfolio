---
import { u } from '../config';
import Chip from './Chip.astro';
const { slug, n, kind, title, oneLiner, url, thumb, heroAlt = '', tags = [] } = Astro.props as any;
---
<a href={u(`/experiences/${slug}/`)} class="card card--pink">
  <div class="card__thumb">
    <img src={u(thumb)} alt={heroAlt} width="720" height="523" loading="lazy" />
  </div>
  <div class="card__body">
    <p class="label label--pink">PORTAL {String(n).padStart(2, '0')} · {kind}</p>
    <h3 class="card__title">{title}</h3>
    <p>{oneLiner}</p>
    <div class="tags">{tags.map((t: string) => <Chip>{t}</Chip>)}</div>
    <p class="label label--indigo">STEP INSIDE →</p>
  </div>
</a>
