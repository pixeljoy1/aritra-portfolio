---
import { u, workUrl } from '../config';
import Base from './Base.astro';
import Panel from '../components/Panel.astro';
import media from '../data/media.json';
const { entry, prev, next } = Astro.props as any;
const d = entry.data;
const m = (media as any)[d.slug];
const yr = { '2024-25': 'Y1', '2025-26': 'Y2', '2026-27': 'Y3' }[d.year as string];
const linkEntries = Object.entries(d.links).filter(([, v]) => v);
---
<Base title={d.title} description={d.oneLiner}>
  <article class="wrap case">
    <p class="label"><a href={u("/work/")}>← WORK</a> <span class="label--indigo">· {yr} · {d.semesters.join(' ')}</span></p>
    <h1 class="display">{d.title}</h1>
    <p class="lede">{d.oneLiner}</p>
    <dl class="meta">
      <div><dt>Course</dt><dd>{d.course}</dd></div>
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      <div><dt>Tools</dt><dd>{d.tools.length ? d.tools.join(', ') : '[CONFIRM TOOLS]'}</dd></div>
      {d.duration && <div><dt>Duration</dt><dd>{d.duration}</dd></div>}
    </dl>
    {m && <a class="case__hero-link" href={u(m.hero)} data-lb data-lb-group={d.slug} data-lb-src={u(m.hero)} data-lb-alt={m.heroAlt} data-lb-title={m.heroAlt} data-lb-meta={d.title}><img class="case__hero" src={u(m.hero)} alt={m.heroAlt} width="1400" height="788" /></a>}
    {d.simulatedData && (
      <Panel variant="pink" label="DATA NOTE">
        <p>Survey and interview data in this project were <strong>simulated for coursework</strong>. Market figures come from published sources.</p>
      </Panel>
    )}
    <div class="prose"><slot /></div>
    {m?.gallery?.length > 0 && (
      <section><h2 class="h2">Gallery</h2>
        <div class="gallery">{m.gallery.map((g: any) => <a href={u(g.src)} class="gallery__item" data-lb data-lb-group={d.slug} data-lb-src={u(g.src)} data-lb-alt={g.alt} data-lb-title={g.alt} data-lb-meta={d.title}><img src={u(g.src)} alt={g.alt} width="1100" height="620" loading="lazy" /></a>)}</div>
      </section>
    )}
    {linkEntries.length > 0 && (
      <section><h2 class="h2">Links</h2>
        <ul>{linkEntries.map(([k, v]) => <li><a href={(v as string).startsWith('/') ? u(v as string) : (v as string)}>{k}</a></li>)}</ul></section>
    )}
    <nav class="prevnext" aria-label="More case studies">
      {prev ? <a href={workUrl(prev.data.slug)}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={workUrl(next.data.slug)}>{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>
