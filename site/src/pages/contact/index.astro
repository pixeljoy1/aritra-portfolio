---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
---
<Base title="Contact">
  <div class="wrap">
    <h1 class="display">CONTACT</h1>
    <ul>
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.github} rel="noopener noreferrer">Source code of this site (GitHub)</a></li>
      {SITE.linkedin && <li><a href={SITE.linkedin} rel="noopener noreferrer">LinkedIn</a></li>}
      <li><a href={SITE.instagram} rel="noopener noreferrer">Instagram: @wildscapeexplorers (wildlife photography)</a></li>
    </ul>
  </div>
</Base>
