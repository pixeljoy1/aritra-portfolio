---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import items from '../../data/experiences.json';
---
<Base title="Experiences" description="VR and XR experiences by Aritra Mitra: walkable and explorable immersive builds that run in a headset or a browser tab.">
  <div class="wrap">
    <Breadcrumb trail={[{ label: 'HOME', href: '/' }, { label: 'EXPERIENCES' }]} />
    <h1 class="display">EXPERIENCES</h1>
    <p class="lede">Builds you can step into: VR and XR experiences that run in a headset or a plain browser tab. Open one to see how it was made, then launch it.</p>
    <div class="grid" id="cards">
      {items.map((x) => <ExperienceCard {...x} />)}
    </div>
    <p class="muted">More VR and XR builds will be added here as the course goes on.</p>
  </div>
</Base>
