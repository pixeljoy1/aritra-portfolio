---
import { u, SITE } from '../../config';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import r from '../../data/resume.json';
---
<Base title="Resume" description="Aritra Mitra's résumé: game and immersive designer. Preview and download the PDF.">
  <div class="wrap">
    <h1 class="display">RESUME</h1>
    <p class="muted">Last updated: {r.updated}</p>
    <p class="resume__actions">
      <a class="btn btn--primary" href={u('/resume.pdf')} download="Aritra_Mitra_Resume_2026.pdf">↓ DOWNLOAD PDF</a>
      <a class="btn btn--secondary" href={u('/resume.pdf')} target="_blank" rel="noopener">OPEN IN NEW TAB</a>
    </p>
    <a class="resume__preview" href={u('/img/resume-preview.webp')} data-lb data-lb-group="resume" data-lb-src={u('/img/resume-preview.webp')}
      data-lb-alt="Aritra Mitra résumé 2026, one page" data-lb-title="Résumé 2026 (one page)" data-lb-meta="Tap to enlarge">
      <img src={u('/img/resume-preview.webp')} alt="Preview of Aritra Mitra's one-page résumé" width="1241" height="1754" />
      <span class="label label--indigo">QUICK PREVIEW · TAP TO ENLARGE</span>
    </a>

    <h2 class="h2">Read as text</h2>
    <Panel label="PROFILE"><p>{r.profile}</p></Panel>
    <Panel label="KEY HIGHLIGHTS"><ul>{r.highlights.map(([k, v]) => <li><strong>{k}.</strong> {v}</li>)}</ul></Panel>
    <Panel label="TOOLBOX"><ul>{r.toolbox.map(([k, v]) => <li><strong>{k}:</strong> {v}</li>)}</ul></Panel>
    <Panel label="SELECTED PROJECTS">
      <ul>{r.projects.map(([y, t, c, d]) => <li><strong>{t}</strong> <span class="muted">({y}) · {c}</span><br />{d}</li>)}</ul>
    </Panel>
    <Panel label="EDUCATION"><p>{r.education}</p><p><strong>Coursework:</strong> {r.coursework}</p><p>{r.interests}</p></Panel>
    <p>Contact: <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.linkedin} rel="noopener noreferrer">LinkedIn</a></p>
  </div>
</Base>
