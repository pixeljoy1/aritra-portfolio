---
import { u, workUrl } from '../../config';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import { YEARS } from '../../config';
import artefacts from '../../data/artefacts.json';
import media from '../../data/media.json';
const photos = (media as any).photos;
export async function getStaticPaths() {
  const ys = await getCollection('years');
  return YEARS.map((y, i) => ({
    params: { year: y.slug },
    props: { y, prev: YEARS[i - 1], next: YEARS[i + 1], entry: ys.find((e) => e.data.slug === y.slug) },
  }));
}
const { y, prev, next, entry } = Astro.props;
const mine = (artefacts as any[]).filter((a) => a.year === y.slug);
const bySem = [...new Set(mine.map((a) => a.semester))].sort();
---
<Base title={`Year ${y.n} · ${y.label}`}>
  <div class="wrap">
    <p class="label"><a href={u("/years/")}>← ALL YEARS</a></p>
    <h1 class="display">YEAR {y.n} · {y.label}</h1>
    <p class="lede">{entry?.data.summary ?? ''}</p>
    {y.slug === '2024-25' && (
      <Panel variant="indigo" label="STARTING POINT · MAY 2024">
        <p>Before the first semester, a visit to the university's VR lab: a headset, a PC and an architectural walkthrough running on screen. This is the kind of space the programme is about.</p>
        <div class="roundrow">
          {['vr-wide', 'vr-close'].map((k) => (
            <a href={u(photos[k].src)} data-lb data-lb-group={y.slug} data-lb-round="1" data-lb-src={u(photos[k].src)} data-lb-alt={photos[k].alt}
              data-lb-title="In the VR lab, May 2024" data-lb-meta="Starting point"><img class="round" src={u(photos[k].sm)} alt={photos[k].alt} width="160" height="160" loading="lazy" /></a>
          ))}
        </div>
      </Panel>
    )}
    {entry?.data.groups.map((g) => (
      <Panel label={`${g.semester} · ${g.topic}`}>
        <ul>
          {g.items.map((it) => (
            <li>
              {it.work ? <a href={workUrl(it.work)}>{it.title}</a> : it.title}
              {it.course && <span class="muted"> — {it.course}</span>}
              {it.note && <span class="placeholder"> {it.note}</span>}
            </li>
          ))}
        </ul>
      </Panel>
    ))}
    {bySem.map((sem) => (
      <section>
        <h2 class="h2">{sem} · Artefacts</h2>
        <div class="grid">
          {mine.filter((a) => a.semester === sem).map((a) => (
            <div class="card artefact">
              <a class="card__thumb" href={u(a.large ?? a.image)} data-lb data-lb-group={y.slug}
                data-lb-src={u(a.large ?? a.image)} data-lb-video={a.video ? u(a.video) : ''} data-lb-alt={`Preview of ${a.title}`}
                data-lb-title={a.title} data-lb-meta={`${a.semester} · ${a.topic}`} data-lb-link={a.work ? workUrl(a.work) : ''}>
                <img src={u(a.image)} alt={`Preview of ${a.title}`} width="640" height="360" loading="lazy" />
                {a.video && <span class="play-badge">▶ PLAY</span>}
              </a>
              <div class="card__body">
                <p class="label label--indigo">{a.topic}</p>
                <p>{a.work ? <a href={workUrl(a.work)}>{a.title}</a> : a.title}</p>
                {a.pdf && <a class="label" href={u(a.pdf)}>OPEN PDF →</a>}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
    <nav class="prevnext" aria-label="Years">
      {prev ? <a href={u(`/years/${prev.slug}/`)}>← PREVIOUS YEAR</a> : <span></span>}
      {next ? <a href={u(`/years/${next.slug}/`)}>NEXT YEAR →</a> : <span></span>}
    </nav>
  </div>
</Base>
